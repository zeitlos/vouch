# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/vouch

# Board customization
BOARD_TITLE=Vouch
BOARD_DESCRIPTION=Share feedback, vote on features.

# Image uploads (optional) — set all three to enable attaching images to posts.
# Works with AWS S3 or any S3-compatible store (MinIO, etc.).
S3_BUCKET=vouch-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# For S3-compatible stores, set the endpoint (omit for real AWS S3).
S3_ENDPOINT=
S3_REGION=us-east-1
# Set to "false" to use virtual-hosted-style addressing (default is path-style).
S3_FORCE_PATH_STYLE=true
